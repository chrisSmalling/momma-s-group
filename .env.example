# Copy to .env.local and fill in from Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Required by the recurring-program materialization cron
# (src/app/api/cron/materialize-programs) — as of v7, EXECUTE on
# materialize_programs() is revoked from anon/authenticated and granted to
# service_role only, so the anon key can no longer call it at all. Keep
# this secret; never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Required for the recurring-program materialization cron
# (src/app/api/cron/materialize-programs) to accept requests. Vercel Cron
# sends this automatically as an Authorization: Bearer header once
# CRON_SECRET is set as a project env var on Vercel — generate any random
# string, e.g. `openssl rand -hex 32`.
# CRON_SECRET=your-random-secret

# Optional — real drive times on the Today screen (src/lib/routing).
# Without this, distances fall back to straight-line (Haversine) and are
# labeled as approximate, never as minutes. Free account, no billing card
# required: https://openrouteservice.org/dev/#/signup
# OPENROUTESERVICE_API_KEY=your-ors-api-key
# ROUTING_PROVIDER=openrouteservice   # default; the swap point for later
