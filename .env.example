# Copy to .env.local and fill in from Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional local/backend-only service credential for administrative scripts.
# Never expose this to browser code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Secret used by any manually invoked protected scheduler endpoint.
# The production discovery scheduler is pg_cron -> discover-local-events-v3
# and authenticates with the Supabase Vault cron secret; Vercel cron is not
# configured for this project.
# CRON_SECRET=your-random-secret

# Optional — real drive times on the Today screen (src/lib/routing).
# Without this, distances fall back to straight-line (Haversine) and are
# labeled as approximate, never as minutes.
# OPENROUTESERVICE_API_KEY=your-ors-api-key
# ROUTING_PROVIDER=openrouteservice
